{
	"name": "@haq/astro",
	"version": "0.1.8",
	"description": "Compile time framework and a lightweight runtime library for building type safe, performant, and scalable vanilla Astro projects.",
	"author": "Amino Belyamani",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/runtime/index.ts",
			"default": "./@dist/runtime/index.js"
		},
		"./cli": {
			"types": "./src/cli/index.ts",
			"default": "./@dist/cli/index.js"
		},
		"./tools": {
			"types": "./src/tools/index.ts",
			"default": "./@dist/tools/index.js"
		},
		"./types": "./src/types.ts",
		"./internal": "./src/internal.ts"
	},
	"scripts": {
		"clean": "rm -rf @dist",
		"compile": "tsc -p ./",
		"deploy:publish": "bash _scripts/deploy.sh",
		"deploy:dry-run": "pnpm dlx jsr publish --dry-run --allow-dirty",
		"watch": "tsc --watch"
	},
	"dependencies": {
		"@astrojs/compiler": "^4.0.0",
		"@biomejs/js-api": "^6.0.0",
		"@biomejs/wasm-nodejs": "^2.5.12",
		"@haq/utils": "workspace:*",
		"@parcel/watcher": "^2.6.0",
		"astro": "^7.3.1",
		"css-tree": "^3.2.1",
		"dotenv": "^17.4.2",
		"jsonrepair": "^3.15.0",
		"piccolore": "^0.1.3",
		"yargs-parser": "^22.0.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/css-tree": "^3.2.0",
		"@types/yargs-parser": "^21.0.3"
	}
}
