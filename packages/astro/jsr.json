{
	"$schema": "https://jsr.io/schema/config-file.v1.json",
	"name": "@haq/astro",
	"version": "0.1.8",
	"license": "AGPL-3.0-or-later",
	"exports": {
		".": "./src/runtime/index.ts",
		"./cli": "./src/cli/index.ts",
		"./tools": "./src/tools/index.ts",
		"./types": "./src/types.ts"
	},
	"publish": {
		"include": ["LICENSE", "README.md", "Tutorial.md", "src/**/*.ts", "_static"],
		"exclude": ["src/ci", "src/internal.ts", "src/runtime/_unused"]
	}
}
