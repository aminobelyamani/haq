{
	"name": "haq",
	"private": true,
	"exports": null,
	"description": "HAQ Monorepo",
	"author": "Amino Belyamani",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"clean": "turbo run clean --force",
		"compile": "turbo run compile",
		"compile-force": "turbo run compile --force",
		"format": "biome format --semicolons=as-needed --trailing-commas=none --line-width=120 packages/ --fix",
		"lint": "biome lint .",
		"preship": "bash @scripts/preship.sh",
		"ship": "bash @scripts/ship.sh",
		"up-all": "pnpm up --latest -r"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@changesets/cli": "^3.0.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.6.1",
		"turbo": "^2.11.1",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.4.2"
}
