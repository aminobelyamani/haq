{
	"name": "haq",
	"private": true,
	"exports": null,
	"description": "HAQ Monorepo",
	"author": "Amino Belyamani",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"clean": "turbo run clean --force",
		"compile": "turbo run compile",
		"compile-force": "turbo run compile --force",
		"deploy:publish": "bash @scripts/publish.sh",
		"publish:astro": "turbo run publish:astro",
		"publish:astro-ssr": "turbo run publish:astro-ssr",
		"publish:language-server": "turbo run publish:language-server",
		"format": "biome format --semicolons=as-needed --trailing-commas=none --line-width=120 packages/ --fix",
		"lint": "biome lint .",
		"preship": "bash @scripts/preship.sh",
		"ship": "bash @scripts/ship.sh",
		"up-all": "pnpm up --latest -r"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "^3.0.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.6.4",
		"turbo": "^2.11.7",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.10.1"
}
